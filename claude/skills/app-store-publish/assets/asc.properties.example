# App Store Connect API credentials for tools/asc_publish.py.
#
# Copy to asc.properties (gitignored) and fill in. Environment variables
# ASC_KEY_ID and ASC_ISSUER_ID override these, which is what CI would use.
#
# Only the .p8 is secret, and it is not named here: the tool looks for it at
# ~/.appstoreconnect/private_keys/AuthKey_<ascKeyId>.p8, which is also where
# xcrun altool looks, so one file serves both.
#
# Both values come from App Store Connect -> Users and Access -> Integrations.
# The key is a *team* key, so the one skugga and wake-alone use is the one this
# game uses; the issuer id is the same for every key in the team.

ascKeyId=
ascIssuerId=

# Optional, for --listing. Apple's category ids; leave unset to keep what the
# console has. Locale defaults to en-US.
#primaryCategory=GAMES
#primarySubcategoryOne=GAMES_SIMULATION
#primarySubcategoryTwo=GAMES_CASUAL
#locale=en-US
