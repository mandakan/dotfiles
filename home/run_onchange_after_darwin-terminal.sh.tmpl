{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# iTerm2: load (and auto-save) preferences from ~/.config/iterm2, which chezmoi
# renders from home/dot_config/iterm2/. Takes effect on the next iTerm2 launch.
# Also installs the MesloLGS NF fonts the Default profile uses; they come from
# powerlevel10k's media repo (the same files `p10k configure` downloads),
# pinned to a commit and sha256-verified.
#
# Runs again whenever this script's content changes (run_onchange_).
set -euo pipefail

# A running iTerm2 only has whatever is in its memory. Once the two keys below
# are set it saves that over ~/.config/iterm2 on its next change, replacing
# the file chezmoi just wrote. So it must be restarted before it saves.
if pgrep -xq iTerm2; then
    printf '\033[1;33m!\033[0m iTerm2 is running. Quit it (Cmd+Q), run `chezmoi apply` again, then relaunch iTerm2.\n' >&2
fi

defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$HOME/.config/iterm2"
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
# "Save changes: Never" (iTermPreferenceSavePrefsModeNever = 1). The folder is
# the source of truth; iTerm2 reads it at launch and never writes it on its
# own. With "Automatically" a launch that could not resolve the profile font
# silently rewrote the file with the substitute (Menlo). To capture a GUI
# change: Settings > General > Settings > "Save Now", then `chezmoi re-add`.
defaults write com.googlecode.iterm2 NoSyncNeverRemindPrefsChangesLostForFile -bool true
defaults write com.googlecode.iterm2 NoSyncNeverRemindPrefsChangesLostForFile_selection -int 1

media_commit=145eb9fbc2f42ee408dacd9b22d8e6e0e553f83d
fontdir="$HOME/Library/Fonts"
mkdir -p "$fontdir"
while IFS='|' read -r name want; do
    target="$fontdir/MesloLGS NF $name.ttf"
    if [[ -f $target ]] && [[ $(shasum -a 256 "$target" | cut -d' ' -f1) == "$want" ]]; then
        continue
    fi
    echo "installing MesloLGS NF $name"
    tmp=$(mktemp)
    curl -fsSL -o "$tmp" "https://raw.githubusercontent.com/romkatv/powerlevel10k-media/$media_commit/MesloLGS%20NF%20${name// /%20}.ttf"
    got=$(shasum -a 256 "$tmp" | cut -d' ' -f1)
    if [[ $got != "$want" ]]; then
        rm -f "$tmp"
        echo "checksum mismatch for MesloLGS NF $name: got $got, want $want" >&2
        exit 1
    fi
    install -m 0644 "$tmp" "$target"
    rm -f "$tmp"
done <<'FONTS'
Regular|d97946186e97f8d7c0139e8983abf40a1d2d086924f2c5dbf1c29bd8f2c6e57d
Bold|b6c0199cf7c7483c8343ea020658925e6de0aeb318b89908152fcb4d19226003
Italic|6f357bcbe2597704e157a915625928bca38364a89c22a4ac36e7a116dcd392ef
Bold Italic|56b4131adecec052c4b324efb818dd326d586dbc316fc68f98f1cae2eb8d1220
FONTS
{{- end }}
