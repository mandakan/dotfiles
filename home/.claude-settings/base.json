{
  "permissions": {
    "allow": [
      "Read(~/.claude-tmp/**)",
      "Write(~/.claude-tmp/**)",
      "Edit(~/.claude-tmp/**)",
      "Bash(mkdir -p ~/.claude-tmp/*)",
      "Bash(ls ~/.claude-tmp/**)",
      "Bash(cat ~/.claude-tmp/**)",
      "Bash(tee ~/.claude-tmp/**)",
      "Bash(mv ~/.claude-tmp/** ~/.claude-tmp/**)",
      "Bash(cp ~/.claude-tmp/** ~/.claude-tmp/**)"
    ],
    "additionalDirectories": [
      "~/.claude-tmp"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "wiki-skills@wiki-skills": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "revenuecat@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "wiki-skills": {
      "source": {
        "source": "github",
        "repo": "kfchou/wiki-skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "RevenueCat": {
      "source": {
        "source": "github",
        "repo": "RevenueCat/ai-toolkit"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
