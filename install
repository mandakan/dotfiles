#!/usr/bin/env bash
# Bootstrap a fresh macOS or Ubuntu machine from this dotfiles repo.
# Safe to re-run: every step is idempotent.
#
# Flow (macOS):
#   1. Homebrew (if missing)
#   2. Oh My Zsh (if missing) + powerlevel10k + zsh plugins
#   3. Claude Code CLI (if missing)
#   4. Symlink shell + editor dotfiles into $HOME
#   5. Symlink ~/.claude config (settings, hooks, statusline)
#   6. brew bundle
#   7. Generate nano syntax-highlight include + sanity-check PATH
#   8. pre-commit install (hook envs built lazily on first commit)
#
# Flow (Linux/Ubuntu): same, but apt-get replaces Homebrew/Brewfile and the
# nano-cellar block is skipped (apt's nano ships syntax files in /usr/share).
#
# Idempotent -- re-run anytime to reconcile drift.
# Existing non-symlink targets are backed up to ~/.dotfiles-backup/<ts>/.

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
OS="$(uname -s)"

log()  { printf '\033[1;34m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# Symlink src → dst. If dst already points to src, do nothing. If dst exists
# and isn't a matching symlink, move it into the timestamped backup dir.
link() {
    local src=$1 dst=$2
    [[ -e $src || -L $src ]] || die "missing source: $src"

    if [[ -L $dst && "$(readlink "$dst")" == "$src" ]]; then
        log "ok    $dst"
        return
    fi
    if [[ -e $dst || -L $dst ]]; then
        mkdir -p "$BACKUP"
        mv "$dst" "$BACKUP/"
        warn "backed up $dst → $BACKUP/"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    log "linked $dst → $src"
}

# Write dst as a copy of src plus extra lines appended. Used for files that
# need a platform-specific tail (e.g. ~/.nanorc) since nano 9.0 rejects
# nested `include` directives, ruling out the symlink+indirection pattern.
# Backs up any pre-existing target (symlink or regular file) that doesn't
# already match the content we're about to write.
write_with_suffix() {
    local src=$1 dst=$2 suffix=$3
    [[ -f $src ]] || die "missing source: $src"

    local tmp
    tmp=$(mktemp)
    { cat "$src"; printf '%s\n' "$suffix"; } > "$tmp"

    if [[ -e $dst && ! -L $dst ]] && cmp -s "$tmp" "$dst"; then
        rm -f "$tmp"
        log "ok    $dst"
        return
    fi
    if [[ -e $dst || -L $dst ]]; then
        mkdir -p "$BACKUP"
        mv "$dst" "$BACKUP/"
        warn "backed up $dst → $BACKUP/"
    fi
    mkdir -p "$(dirname "$dst")"
    mv "$tmp" "$dst"
    log "wrote  $dst (from $src + platform suffix)"
}

# ─── 0. Flags ─────────────────────────────────────────────────────────────
# Pinned pay-respects release. Defined up here (not in section 1b) so
# --check-updates can run before any install steps have side effects.
PR_VERSION=0.8.8

# `./install --check-updates`: compare the pinned pay-respects version against
# the latest tagged GitHub release and print the bump checklist if it's stale.
# The sed pattern only matches `v<digits>` tags, so the moving `nightly` tag
# can never be reported as an update. Exits without installing anything.
if [[ ${1:-} == --check-updates ]]; then
    latest=$(curl -fsSL --max-time 10 \
        https://api.github.com/repos/iffse/pay-respects/releases/latest \
        | sed -n 's/.*"tag_name": *"v\([0-9.][0-9.]*\)".*/\1/p')
    [[ -n $latest ]] || die "could not determine latest pay-respects release"

    if [[ $latest == "$PR_VERSION" ]]; then
        log "ok    pay-respects $PR_VERSION is the latest release"
        exit 0
    fi

    warn "pay-respects $latest is out (pinned: $PR_VERSION)"
    printf '\nBump checklist:\n'
    printf '  1. Set PR_VERSION=%s in this script\n' "$latest"
    printf '  2. Update the four sha256 checksums; compute each with:\n'
    for t in aarch64-apple-darwin x86_64-apple-darwin \
             aarch64-unknown-linux-musl x86_64-unknown-linux-musl; do
        printf '       curl -fsSL https://github.com/iffse/pay-respects/releases/download/v%s/pay-respects-%s-%s.tar.zst | shasum -a 256\n' \
            "$latest" "$latest" "$t"
    done
    printf '  3. In .zshrc, delete the __pr_base override (p10k workaround) and\n'
    printf '     switch the eval to: pay-respects zsh --alias --prompt-prefix '\''❯'\''\n'
    printf '     (verify the flag against the release notes first)\n'
    printf '  4. Re-run ./install\n'
    exit 1
fi

# ─── 1. System packages ──────────────────────────────────────────────────

case "$OS" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            log "installing Homebrew"
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        fi
        eval "$(/opt/homebrew/bin/brew shellenv)"
        # Apple's bsdtar is built without libzstd and shells out to `zstd`,
        # which section 1b needs to unpack the pay-respects .tar.zst.
        command -v zstd >/dev/null 2>&1 || brew install zstd
        ;;
    Linux)
        command -v apt-get >/dev/null 2>&1 || die "this script only supports macOS or apt-based Linux"
        log "installing base packages via apt"
        sudo apt-get update -qq
        sudo apt-get install -y --no-install-recommends \
            zsh git curl nano fzf pre-commit ca-certificates zstd
        ;;
    *)
        die "unsupported OS: $OS"
        ;;
esac

# ─── 1b. pay-respects (replaces thefuck, which broke on Python 3.12+) ────
# Static binary, pinned version, sha256-verified. Installs to ~/.local/bin
# (already on PATH via .zshrc) so no sudo and no platform-specific package
# manager dance. The previous brew-tap path pulled `nightly` builds; the
# previous apt path required dpkg + sudo. Same code path on macOS/Linux.
# PR_VERSION is pinned in section 0 (so --check-updates runs install-free).

install_pay_respects() {
    local bindir="$HOME/.local/bin" target="$HOME/.local/bin/pay-respects"
    if [[ -x $target ]] && "$target" --version 2>/dev/null | grep -q " $PR_VERSION\$"; then
        log "ok    pay-respects $PR_VERSION"
        return
    fi

    # Triple + sha256 picked together so we never download an arch we can't verify.
    local triple want
    case "$OS-$(uname -m)" in
        Darwin-arm64)
            triple=aarch64-apple-darwin
            want=e834e928dcaf9cd72a99478bb61e0630ba76e32c7b228eb3a7be9c5f404cd548 ;;
        Darwin-x86_64)
            triple=x86_64-apple-darwin
            want=64c30e1a62605279abf219193c53bf251687ea419a0c99d2e15ae8b5b6a58587 ;;
        Linux-aarch64|Linux-arm64)
            triple=aarch64-unknown-linux-musl
            want=c63ce37f25f4b8f7fc8ffd46955a22cb05314991560822f7de77e8190d3d9ca4 ;;
        Linux-x86_64)
            triple=x86_64-unknown-linux-musl
            want=20bb89e9fa114b20ce78b57ece77134e79e314fd0d5086e9695c0de7f98ccaaf ;;
        *) die "no pay-respects binary for $OS-$(uname -m)" ;;
    esac

    local url="https://github.com/iffse/pay-respects/releases/download/v${PR_VERSION}/pay-respects-${PR_VERSION}-${triple}.tar.zst"
    log "installing pay-respects $PR_VERSION ($triple)"

    local tmp
    tmp=$(mktemp -d)
    curl -fsSL -o "$tmp/pr.tar.zst" "$url"
    local got
    got=$(shasum -a 256 "$tmp/pr.tar.zst" | awk '{print $1}')
    if [[ $got != "$want" ]]; then
        rm -rf "$tmp"
        die "pay-respects checksum mismatch: got $got, want $want"
    fi
    tar -xf "$tmp/pr.tar.zst" -C "$tmp"
    mkdir -p "$bindir"
    install -m 0755 "$tmp/pay-respects" "$bindir/pay-respects"
    install -m 0755 "$tmp/_pay-respects-module-100-runtime-rules" "$bindir/"
    install -m 0755 "$tmp/_pay-respects-fallback-100-request-ai"  "$bindir/"
    rm -rf "$tmp"
}
install_pay_respects

# ─── 2. Oh My Zsh ────────────────────────────────────────────────────────

if [[ ! -d $HOME/.oh-my-zsh ]]; then
    log "installing Oh My Zsh"
    # RUNZSH=no prevents the installer from launching an interactive shell.
    # CHSH=no prevents it from changing the login shell (do that manually).
    RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

clone_once() {
    local repo=$1 dest=$2
    if [[ -d $dest ]]; then
        log "ok    $dest"
    else
        log "clone $repo → $dest"
        git clone --depth=1 "$repo" "$dest"
    fi
}

clone_once https://github.com/romkatv/powerlevel10k.git          "$ZSH_CUSTOM/themes/powerlevel10k"
clone_once https://github.com/zsh-users/zsh-autosuggestions.git  "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
clone_once https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"

# ─── 3. Claude Code CLI ──────────────────────────────────────────────────

if ! command -v claude >/dev/null 2>&1; then
    log "installing Claude Code CLI"
    curl -fsSL https://claude.ai/install.sh | bash
fi

# ─── 4. Symlink shell + editor dotfiles ──────────────────────────────────

link "$DOTFILES/.zshrc"    "$HOME/.zshrc"
link "$DOTFILES/.p10k.zsh" "$HOME/.p10k.zsh"
link "$DOTFILES/Brewfile"  "$HOME/Brewfile"

# ~/.nanorc is generated below (case "$OS" in ...) -- it can't be a symlink
# because the syntax-highlight include line is platform-specific.

# Clean up the old indirection file from previous installs. ~/.nanorc no
# longer references it, so leaving it around just confuses future debuggers.
if [[ -e $HOME/.nano-syntax.nanorc || -L $HOME/.nano-syntax.nanorc ]]; then
    rm -f "$HOME/.nano-syntax.nanorc"
    log "removed legacy $HOME/.nano-syntax.nanorc"
fi

# ─── 5. Claude Code config ───────────────────────────────────────────────

link "$DOTFILES/claude/settings.json"  "$HOME/.claude/settings.json"
link "$DOTFILES/claude/CLAUDE.md"      "$HOME/.claude/CLAUDE.md"
link "$DOTFILES/claude/RTK.md"         "$HOME/.claude/RTK.md"
link "$DOTFILES/claude/statusline.sh"  "$HOME/.claude/statusline.sh"
link "$DOTFILES/claude/skills/clean-prose" "$HOME/.claude/skills/clean-prose"
link "$DOTFILES/claude/skills/play-publish" "$HOME/.claude/skills/play-publish"

# The shell-based rtk hook was replaced by the native `rtk hook claude`
# (see settings.json); drop the symlink older installs left behind.
if [[ -L $HOME/.claude/hooks/rtk-rewrite.sh ]]; then
    rm -f "$HOME/.claude/hooks/rtk-rewrite.sh"
    log "removed legacy $HOME/.claude/hooks/rtk-rewrite.sh"
fi

# ─── 6. Package bundle + nano syntax highlighting ────────────────────────

case "$OS" in
    Darwin)
        log "running brew bundle (this may take a while)"
        brew bundle --file="$DOTFILES/Brewfile"

        # Brew's nano cellar path differs between Apple Silicon (/opt/homebrew)
        # and Intel (/usr/local), and the version segment changes per upgrade.
        # `brew --cellar nano` resolves both; the glob handles the version.
        if nano_cellar=$(brew --cellar nano 2>/dev/null) && [[ -n $nano_cellar ]]; then
            write_with_suffix "$DOTFILES/.nanorc" "$HOME/.nanorc" \
                "include \"$nano_cellar/*/share/nano/*.nanorc\""
        else
            link "$DOTFILES/.nanorc" "$HOME/.nanorc"
        fi

        if command -v nano >/dev/null 2>&1; then
            actual=$(command -v nano)
            if [[ $actual != "$(brew --prefix)"/* ]]; then
                warn "\`nano\` resolves to $actual, not brew's nano."
                warn "Start a fresh shell (\`exec zsh\`) -- PATH probably just needs reload."
            fi
        fi
        ;;
    Linux)
        # apt's nano ships syntax files in /usr/share/nano.
        write_with_suffix "$DOTFILES/.nanorc" "$HOME/.nanorc" \
            'include "/usr/share/nano/*.nanorc"'
        ;;
esac

# ─── 7. pre-commit hooks ─────────────────────────────────────────────────
# Only register the git hook — don't build hook environments yet. Eager env
# setup (--install-hooks) invokes `python`, which can fail when the current
# shell's $PATH still holds stale pyenv shims from a previous .zshrc. Hook
# envs build lazily on the first commit from a fresh shell, which sidesteps
# the issue entirely.

if command -v pre-commit >/dev/null 2>&1 && [[ -f $DOTFILES/.pre-commit-config.yaml ]]; then
    log "installing pre-commit git hook into $DOTFILES"
    (cd "$DOTFILES" && pre-commit install)
fi

log "done."
[[ -d $BACKUP ]] && warn "previous files were backed up to $BACKUP"
log "start a fresh shell (or \`exec zsh\`) to pick up the new environment."
